# ================================================================
# DROPSHIPPING E-COMMERCE PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ================================================================

# ----------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# Get from: https://supabase.com/dashboard → Project → Settings → Database
# ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ----------------------------------------------------------------
# AUTH (NextAuth.js v5 / Auth.js)
# Generate a strong random secret:
#   openssl rand -base64 32
# ----------------------------------------------------------------
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------
# SUPABASE (Realtime + Storage)
# Get from: https://supabase.com/dashboard → Project → Settings → API
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ----------------------------------------------------------------
# UPLOADTHING (File Storage)
# Get from: https://uploadthing.com/dashboard
# ----------------------------------------------------------------
UPLOADTHING_TOKEN="your-uploadthing-token"

# ----------------------------------------------------------------
# RAZORPAY (Primary Payment Gateway)
# Get from: https://dashboard.razorpay.com/app/keys
# Use test keys during development (rzp_test_*)
# ----------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ----------------------------------------------------------------
# RESEND (Email)
# Get from: https://resend.com/api-keys
# ----------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Your Store Name"

# ----------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YourStore"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# ----------------------------------------------------------------
# ADMIN
# ----------------------------------------------------------------
ADMIN_EMAIL="admin@yourdomain.com"

# ----------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# ----------------------------------------------------------------
# ANALYTICS (Optional — for future integration)
# ----------------------------------------------------------------
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# FACEBOOK_PIXEL_ID="XXXXXXXXXX"

# ----------------------------------------------------------------
# STRIPE (Future — optional alternate payment gateway)
# ----------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ----------------------------------------------------------------
# SUPPLIER API (Future — leave blank for V1 manual workflow)
# ----------------------------------------------------------------
# SUPPLIER_API_KEY=""
# SUPPLIER_API_URL=""
